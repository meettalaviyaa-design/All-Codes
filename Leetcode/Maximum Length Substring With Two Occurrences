class Solution {
    public int maximumLengthSubstring(String s) {
        int n = s.length();
        int i = 0, maxLen = 0;
        
        HashMap<Character, Integer> map = new HashMap<>();
        
        for (int j = 0; j < n; j++) {
            char ch = s.charAt(j);
            map.put(ch, map.getOrDefault(ch, 0) + 1);
            
            while (map.get(ch) > 2) {
                char left = s.charAt(i);
                map.put(left, map.get(left) - 1);
                i++;
            }
            
            maxLen = Math.max(maxLen, j - i + 1);
        }
        
        return maxLen;
    }
}
