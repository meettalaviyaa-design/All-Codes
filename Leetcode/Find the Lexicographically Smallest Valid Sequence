class Solution {
    public int[] validSequence(String word1, String word2) {
        int n = word1.length();
        int m = word2.length();

        int[] suffix = new int[n + 1];
        int j = m - 1;

        for (int i = n - 1; i >= 0; i--) {
            if (j >= 0 && word1.charAt(i) == word2.charAt(j)) {
                j--;
            }
            suffix[i] = m - 1 - j;
        }

        int[] ans = new int[m];
        int i = 0, k = 0;
        boolean usedMismatch = false;

        while (i < n && k < m) {

            if (word1.charAt(i) == word2.charAt(k)) {
                ans[k++] = i;
                i++;
            }
            else {
                if (!usedMismatch) {
                    int remaining = m - (k + 1);

                    if (i + 1 <= n && suffix[i + 1] >= remaining) {
                        usedMismatch = true;
                        ans[k++] = i;
                        i++;
                    } else {
                        i++;
                    }
                } else {
                    i++;
                }
            }
        }

        if (k == m) return ans;
        return new int[0];
    }
}
