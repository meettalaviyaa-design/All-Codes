class Solution {
    public List<Integer> findMissingElements(int[] nums) {
		
		Arrays.sort(nums);
		
		HashMap<Integer, Integer> hs=new HashMap<>();
		for(int i=0;i<nums.length;i++) {
			hs.put(nums[i], i);
		}
		
		List<Integer> al=new ArrayList<>();
		
		int start=nums[0];
		int end=nums[nums.length-1];
		
		while(end>start) {
			if(!hs.containsKey(start)) {
				al.add(start);
			}
			start++;
		}
		
		return al;
    }
}
